{
  "name": "@echotint/dsh-pomodoro",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EchoTint/dsh-pomodoro.git"
  },
  "homepage": "https://github.com/EchoTint/dsh-pomodoro#readme",
  "bugs": { "url": "https://github.com/EchoTint/dsh-pomodoro/issues" },
  "type": "module",
  "description": "Pomodoro timer for DSH with a sidebar workspace, desktop widgets, task tracking, focus statistics, and WebDAV/S3 backups.",
  "icon": "./icon.svg",
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "3.19.0",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./core": "./core.js",
    "./stats": "./stats.js",
    "./store": "./store.js",
    "./backup": "./backup.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "core.js",
    "stats.js",
    "store.js",
    "backup.js",
    "config.js",
    "credentials.js",
    "scripts/runtime-check.mjs",
    "scripts/host-imports.mjs",
    "compliance.test.mjs",
    "packaging.test.mjs",
    "core.test.mjs",
    "widget.html",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "runtime",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "test": "node --test core.test.mjs packaging.test.mjs",
    "test:host": "node --import ./scripts/host-imports.mjs --test core.test.mjs compliance.test.mjs packaging.test.mjs",
    "check:runtime": "node scripts/runtime-check.mjs",
    "check:package": "node scripts/runtime-check.mjs --pack"
  }
}